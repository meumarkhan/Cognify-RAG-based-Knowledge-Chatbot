# Copy this file to .env (used by docker-compose, both for variable
# substitution and as the backend container's env_file) and fill in real values.
# Never commit the real .env file.

# --- LLM (Groq) ---
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
MODEL=llama-3.3-70b-versatile

# --- CORS ---
# Comma-separated list of allowed origins, e.g. https://yourdomain.com
ALLOWED_ORIGINS=*

# --- Redis ---
# Used by both the backend container and the redis service command.
REDIS_PASSWORD=change-me-to-a-strong-password

# --- ChromaDB ---
# Only set to TRUE for local development; leave unset/FALSE in production.
CHROMA_ALLOW_RESET=FALSE
